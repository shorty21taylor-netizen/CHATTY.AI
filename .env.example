# Chatty AI - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# DATABASE (Railway Postgres — must have pgvector extension enabled)
# ============================================
# Railway Postgres URL. The DB must have the `vector` extension enabled
# (Railway does this automatically on Postgres 15+). Used by Drizzle ORM,
# the raw pg Pool, and the seed script.
DATABASE_URL=postgresql://user:password@host:port/db

# ============================================
# CACHE (Railway Redis)
# ============================================
REDIS_URL=redis://default:password@host:port

# ============================================
# AUTHENTICATION (Clerk)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ============================================
# AI & EMBEDDINGS
# ============================================
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3

# ============================================
# VOICE (ElevenLabs ONLY - NO VAPI)
# ============================================
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
ELEVENLABS_WEBHOOK_SECRET=...

# ============================================
# META DMs (Messenger / Instagram)
# ============================================
META_APP_SECRET=...
META_VERIFY_TOKEN=...

# ============================================
# SMS (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ============================================
# PAYMENTS (Stripe)
# ============================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ============================================
# BACKGROUND JOBS (Inngest)
# ============================================
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-...

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
